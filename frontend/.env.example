# Copy this file to .env.local for local development (pnpm dev).
# .env.local is gitignored. Do not commit real keys.

# Resend API key — create at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxx

# Email where contact form submissions are sent
CONTACT_EMAIL=you@example.com

# Optional: overrides from .env.development / .env.production
# FROM_EMAIL=onboarding@resend.dev
# FROM_NAME=Kalekye Contact
